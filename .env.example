# Neon PostgreSQL Connection URL
DATABASE_URL="YOUR_NEON_DATABASE_CONNECTION_STRING"

# NextAuth Configuration Secrets
NEXTAUTH_SECRET="your-generated-nextauth-jwt-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth App Registration Credentials
GOOGLE_CLIENT_ID="google-client-id-here"
GOOGLE_CLIENT_SECRET="google-client-secret-here"

# Cloudinary Storage Media Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Stripe Payment Credentials
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."


# Nodemailer / Gmail Credentials
EMAIL_USER="your-gmail-address@gmail.com"
EMAIL_APP_PASSWORD="your-16-character-app-password"
