datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name       String?
  email      String   @unique
  password   String
  emailVerified Boolean @default(false)
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  userSkills    UserSkill[]
  careerPaths   CareerPath[]
  notifications Notification[]
  subscriptions Subscription[]
  payments      Payment[]
  learningResources LearningResource[]
  atsAnalyses   ATSAnalysis[]

  // Extended Profile Settings
  jobTitle             String?
  experienceLevel      String?
  location             String?
  bio                  String?

  // Notification Settings
  emailNotifications   Boolean @default(true)
  jobAlerts            Boolean @default(true)
  atsAnalysisUpdates   Boolean @default(true)
  weeklyCareerInsights Boolean @default(true)

  // Security Settings
  twoFactorEnabled     Boolean @default(false)
  failedLoginAttempts  Int     @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")

  savedJobs            SavedJob[]
  jobRecommendations   JobRecommendation[]
  targetRoles          TargetRole[]
  skillGaps            SkillGap[]
  learningRoadmaps     LearningRoadmap[]
  skillProgresses      SkillProgress[]
  careerGoals          CareerGoal[]
  searchHistories      SearchHistory[]
  preferences          UserPreferences?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Resume {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  fileName   String     @map("file_name")
  fileUrl    String     @map("file_url")
  fileType            String     @map("file_type")
  parsedText          String?    @map("parsed_text") @db.Text
  targetRole          String?    @map("target_role")
  qualitativeAnalysis Json?      @map("qualitative_analysis")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  atsScores AtsScore[]

  @@map("resumes")
}

model AtsScore {
  id                 String   @id @default(cuid())
  resumeId           String   @map("resume_id")
  targetRole         String   @map("target_role")
  score              Int
  keywordsFound      String[] @map("keywords_found")
  keywordsMissing    String[] @map("keywords_missing")
  formattingFeedback String?  @map("formatting_feedback") @db.Text
  sectionAnalysis    String?  @map("section_analysis") @db.Text
  improvements       String?  @map("improvements") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("ats_scores")
}

model Job {
  id              String   @id @default(cuid())
  externalId      String   @unique @map("external_id")
  title           String
  company         String
  location        String?
  description     String   @db.Text
  employmentType  String?  @map("employment_type")
  experienceLevel String?  @map("experience_level")
  salaryMin       Int?     @map("salary_min")
  salaryMax       Int?     @map("salary_max")
  remote          Boolean  @default(false)
  applyUrl        String   @map("apply_url")
  skills          String[]
  logoUrl         String?  @map("logo_url")
  createdAt       DateTime @default(now()) @map("created_at")

  savedJobs SavedJob[]
  recommendations JobRecommendation[]

  @@map("jobs")
}

model SavedJob {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  jobId      String   @map("job_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model JobRecommendation {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  jobId         String   @map("job_id")
  matchScore    Int      @map("match_score")
  missingSkills String[] @map("missing_skills")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("job_recommendations")
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  category  String      // Frontend, Backend, Design, Management, etc.
  createdAt DateTime    @default(now()) @map("created_at")
  
  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  skillId     String   @map("skill_id")
  proficiency String   // Beginner, Intermediate, Expert
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model CareerPath {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  targetRole  String   @map("target_role")
  description String   @db.Text
  roadmapData String   @map("roadmap_data") @db.Text // JSON string representing timeline milestones
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_paths")
}

model LearningResource {
  id          String   @id @default(cuid())
  title       String
  provider    String
  url         String
  type        String   // Course, Video, Book, Article
  difficulty  String   // Beginner, Intermediate, Advanced
  duration    String
  rating      Float?
  skills      String[]
  isCompleted Boolean  @default(false) @map("is_completed")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_resources")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // info, success, warning, alert
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  plan             String    // Free, Pro, Premium, Enterprise
  status           String    // Active, Cancelled, Expired
  currentPeriodEnd DateTime? @map("current_period_end")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  renewalDate      DateTime? @map("renewal_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  invoiceId   String   @map("invoice_id")
  plan        String
  amount      Float
  currency    String   @default("INR")
  paymentDate DateTime @map("payment_date")
  status      String   @default("Paid")  // Paid, Pending, Failed
  invoiceUrl  String?  @map("invoice_url")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model VerificationOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_otps")
}

model ATSAnalysis {
  id                String   @id @default(cuid())
  userId            String
  resumeName        String
  atsScore          Int
  keywordScore      Int
  skillsScore       Int
  experienceScore   Int
  educationScore    Int
  formattingScore   Int
  readabilityScore  Int      @default(0)
  contactInfoScore  Int      @default(0)
  targetRole        String?
  industry          String?
  experienceLevel   String?
  scoreBreakdown    Json?
  matchedKeywords   String[]
  missingKeywords   String[]
  recommendations   Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ats_analyses")
}

model TargetRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("target_roles")
}

model SkillGap {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  targetRole     String   @map("target_role")
  matchScore     Int      @map("match_score")
  criticalSkills String[] @map("critical_skills")
  recommendedSkills String[] @map("recommended_skills")
  optionalSkills String[] @map("optional_skills")
  jobReadiness   String   @map("job_readiness") // Beginner, Intermediate, Job Ready
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skill_gaps")
}

model LearningRoadmap {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  targetRole  String   @map("target_role")
  title       String
  description String   @db.Text
  week        Int
  resources   String[] // JSON string array
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_roadmaps")
}

model SkillProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  skillName String   @map("skill_name")
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skill_progress")
}

model CareerGoal {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  targetRole     String    @map("target_role")
  targetCompany  String?   @map("target_company")
  targetSalary   Int?      @map("target_salary")
  targetTimeline String?   @map("target_timeline")
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_goals")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  query     String
  filters   Json?    @map("filters")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  roles            String[]
  locations        String[]
  experienceLevels String[] @map("experience_levels")
  jobTypes         String[] @map("job_types")
  remoteOnly       Boolean  @default(false) @map("remote_only")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
